{
  "name": "repo-backend-v2",
  "version": "2.0.0-alpha.11",
  "description": "Digital DU Repository dashboard (ingest-service)",
  "main": "repo-backend-v2.js",
  "private": true,
  "license": "Apache-2.0",
  "author": "fernando.reyes@du.edu",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "start": "node repo-backend-v2.js",
    "dev": "node --watch repo-backend-v2.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:e2e": "vitest --run tests/e2e",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:repo": "knex migrate:latest --knexfile knexfile.js --env repo",
    "migrate:queue": "knex migrate:latest --knexfile knexfile.js --env repo_queue",
    "migrate:all": "npm run migrate:repo && npm run migrate:queue",
    "migrate:status:repo": "knex migrate:status --knexfile knexfile.js --env repo",
    "migrate:status:queue": "knex migrate:status --knexfile knexfile.js --env repo_queue",
    "migrate:rollback:repo": "knex migrate:rollback --knexfile knexfile.js --env repo",
    "migrate:rollback:queue": "knex migrate:rollback --knexfile knexfile.js --env repo_queue",
    "migrate:make:repo": "knex migrate:make --knexfile knexfile.js --env repo",
    "migrate:make:queue": "knex migrate:make --knexfile knexfile.js --env repo_queue"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "ajv": "^8.17.1",
    "axios": "^1.7.7",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.1.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.2",
    "kaltura-client": "^21.13.0",
    "knex": "^3.1.0",
    "log4js": "^6.9.1",
    "lru-cache": "^11.0.2",
    "method-override": "^3.0.0",
    "multer": "^2.1.1",
    "mysql2": "^3.11.4",
    "uuid": "^11.0.3",
    "validator": "^13.12.0",
    "xml2js": "^0.6.2",
    "xmldoc": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vitest/coverage-v8": "^3.0.0",
    "better-sqlite3": "^11.5.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
