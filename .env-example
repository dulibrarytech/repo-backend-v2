# ============================================================================
# repo-backend-v2 — environment template
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=repo-backend-v2
APP_VERSION=2.0.0-alpha.0
ORGANIZATION=University of Denver Libraries
NODE_ENV=development

HOST=http://localhost:8000/
APP_HOST=localhost
APP_PORT=8000
APP_PATH=/repo
API_URL=http://localhost:8000

# Legacy v1 API key. NOT consumed by v2 — the v2 public API at
# /repo/api/v1/* is unauthenticated. Kept here only for parity with v1
# env files; safe to leave blank.
API_KEY=

# --- Auth / JWT --------------------------------------------------------------
# Generate with https://randomkeygen.com
TOKEN_SECRET=
TOKEN_ALGO=HS512
TOKEN_EXPIRES=12h
TOKEN_ISSUER=https://example.invalid

# --- SSO ---------------------------------------------------------------------
# Layered defenses for the /repo/auth/sso callback endpoint. Each layer
# is independent and toggles via env. See docs/MODERNIZATION_PLAN.md for
# the threat model and rollout sequence.
#
# Layer 0 (legacy compat): kept as belt-and-braces only.
SSO_HOST=authproxy.du.edu
# Where to redirect users when they click "Sign in with DU SSO"
SSO_URL=https://authproxy.du.edu/secure/
# Where the upstream IdP POSTs the callback. v2 appends this to the
# start redirect as ?app_url=... so authproxy uses the same convention
# the legacy backend relied on. Must point at the v2 endpoint:
#   /repo/auth/sso  (NOT the legacy /repo/sso)
SSO_RESPONSE_URL=
# Central IdP logout URL. When set, the dashboard logout redirects here
# so the user signs out at DU central, not just our local session.
SSO_LOGOUT_URL=
# Where to land after a successful SSO callback (must start with /).
SSO_DEFAULT_REDIRECT=/repo/dashboard/

# Layer 1: source IP allowlist. Comma-separated IPs or CIDR ranges.
# Empty disables the layer. STRONGLY recommend populating in production.
SSO_TRUSTED_IPS=

# Layer 2: timestamp + nonce freshness check. Requires the upstream proxy
# to include `timestamp` (Unix seconds) and `nonce` (>=8 chars) in the
# POST body. Replays within max_skew_seconds are rejected.
SSO_REQUIRE_FRESHNESS=0
SSO_MAX_SKEW_SECONDS=60

# Layer 3: HMAC-SHA256 signature. Requires the upstream proxy to include
# `signature = hex(HMAC-SHA256(employeeID + '|' + timestamp + '|' + nonce, secret))`
# in the POST body. Verified in constant time. SSO_HMAC_SECRET_NEXT is
# accepted for zero-downtime rotation.
SSO_REQUIRE_HMAC=0
SSO_HMAC_SECRET=
SSO_HMAC_SECRET_NEXT=

# --- Elasticsearch -----------------------------------------------------------
# v2 maintains a single PUBLIC index. The legacy back/admin index was
# retired with the move to a DB-backed dashboard search — staff queries
# now hit MariaDB directly, and only public-facing content lives in ES.
# (ELASTICSEARCH_BACK_INDEX from v1 is no longer read.)
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_FRONT_INDEX=repo_public
ELASTICSEARCH_SHARDS=3
ELASTICSEARCH_REPLICAS=2
ELASTICSEARCH_TIMEOUT_MS=10000

# TLS — point at a PEM file containing any CA certs that should be
# trusted IN ADDITION to Node's bundled roots. Use this when ES is
# behind an internal CA (e.g. InCommon for DU) OR when the ES server
# is misconfigured and doesn't send its intermediate chain — drop the
# missing intermediate into a file and reference it here. Leave empty
# to use only Node's default trust store.
ELASTICSEARCH_CA_CERT_FILE=
# DEV-ONLY escape hatch. Setting this to 0/false disables TLS cert
# verification for the ES connection entirely. The client logs a loud
# warning when this is off. NEVER set this to 0 in production — fix
# the cert chain (ELASTICSEARCH_CA_CERT_FILE) instead.
ELASTICSEARCH_REJECT_UNAUTHORIZED=1

# Indexer worker. Mirrors metadata_worker tunables. The worker polls
# tbl_objects for is_updated=1 rows and pushes them to ES.
INDEXER_ENABLED=1
INDEXER_CONCURRENCY=5
INDEXER_POLL_MS=8000

# --- Database: repo (objects + users) ----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=repo
REPO_OBJECTS=tbl_objects
REPO_USERS=tbl_users

# --- Database: repo_queue (ingest + jobs + metadata queue) -------------------
DB_QUEUE_HOST=127.0.0.1
DB_QUEUE_PORT=3306
DB_QUEUE_USER=
DB_QUEUE_PASSWORD=
DB_QUEUE_NAME=repo_queue
REPO_INGEST_QUEUE=tbl_ingest_queue
REPO_JOBS=tbl_jobs
REPO_METADATA_UPDATE_QUEUE=tbl_metadata_update_queue
REPO_KALTURA_IDS=tbl_kaltura_ids
REPO_KALTURA_PACKAGE_QUEUE=tbl_kaltura_package_queue

# --- Curation API (QA + ASTools both live here) -----------------------------
# Single Python service (digitaldu-backend-curation-service) hosts BOTH
# workflow surfaces:
#
#   /api/v2/qa/*     — QA endpoints (pre-ingest folder ops, SFTP push,
#                      upload-status polling). See ingester/libs/qa_service.js.
#   /api/v1/astools/* — AStools endpoints (workspace inventory,
#                       make-digital-objects, revert, uri.txt reads).
#                       See ingester/libs/astools.js.
#
# One URL + one API key serves both. Auth scheme is X-API-Key header.
CURATION_API=http://libsftp01-vlp.du.edu:8185
CURATION_API_KEY=
# Per-request HTTP budget (default 30s). Two long-running endpoints
# get their own knobs:
#   - move_timeout_ms — QA move-to-sftp / move-to-ingest (~30 min)
#   - mdo_timeout_ms  — AStools make-digital-objects (~1 hr)
CURATION_API_TIMEOUT_MS=30000
CURATION_API_MOVE_TIMEOUT_MS=1800000
CURATION_API_MDO_TIMEOUT_MS=3600000
#
# Back-compat: legacy env names from earlier v2 iterations
# (QA_SERVICE, QA_SERVICE_API_KEY, ASTOOLS_SERVICE, ASTOOLS_API_KEY,
# plus their *_TIMEOUT_MS / *_MOVE_TIMEOUT_MS / *_MDO_TIMEOUT_MS
# variants) are still honored if CURATION_API_* are unset. Migrate
# to the canonical names above when convenient.

# --- Ingest worker -----------------------------------------------------------
# Drives packages through the 5-stage pipeline (process_metadata →
# upload → AM transfer/ingest → DuraCloud → repository). Concurrency
# caps work in flight; poll_ms controls how often the worker wakes
# to claim PENDING rows. The stage-specific budgets bound the long
# polls against upstream services.
INGEST_WORKER_ENABLED=true
INGEST_WORKER_CONCURRENCY=2
# Serial pipeline (default ON): one package at a time through stages 1-5
# (metadata -> upload -> AM transfer -> AM ingest -> repository record);
# the next package starts only when the previous one is done. Stage 6
# (AIP -> Wasabi copy) runs in the background either way. Set 0 to
# restore the old interleaved behavior.
INGEST_PIPELINE_SERIAL=1
INGEST_WORKER_POLL_MS=5000
# Stage 2 — upload (QA SFTP push + status poll). 60s cadence, 4h budget.
INGEST_UPLOAD_POLL_MS=60000
INGEST_UPLOAD_TIMEOUT_MS=14400000
# Stage 3 — AM transfer (approval poll + status poll).
INGEST_APPROVE_POLL_MS=5000
INGEST_APPROVE_TIMEOUT_MS=600000
INGEST_TRANSFER_POLL_MS=5000
INGEST_TRANSFER_TIMEOUT_MS=21600000
# Stage 4 — AM ingest + DuraCloud wait.
INGEST_INGEST_POLL_MS=5000
INGEST_INGEST_TIMEOUT_MS=21600000
INGEST_DURACLOUD_POLL_MS=60000
INGEST_DURACLOUD_TIMEOUT_MS=3600000

# --- AIP-store Stage 6 (preservation copy to Wasabi S3) ---------------------
# Stage 6 fires after Stage 5 finalizes the repository record. It calls the
# Python curation service (/api/v2/aip/copy-to-wasabi) which downloads the
# AM-produced AIP from Archivematica Storage Service and uploads it to
# Wasabi. The Node side never touches Wasabi credentials — those stay in
# the curation service's .env (WASABI_ENDPOINT, WASABI_BUCKET, AWS_*).
#
# AIP_STORE_ENABLED=false makes Stage 5 finalize ingests the way it did
# before Stage 6 existed (COMPLETE + is_complete=1). Default off; flip on
# in dev, soak, then prod.
AIP_STORE_ENABLED=false
# Wall-clock budget for the curation /copy-to-wasabi call. Multi-GB AIPs
# can take many minutes; default 60 min is generous. On timeout, Stage 6
# records the row as failed and retries via the backoff schedule below.
AIP_STORE_COPY_TIMEOUT_MS=3600000
# Presigned-URL TTL for dashboard downloads. Clamped server-side to
# [60, 3600]. Short by default so a leaked URL has small blast radius.
AIP_STORE_PRESIGN_TTL_SECONDS=900
# Stage 6 retry policy. Mirrors metadata_worker.retry_*; tuned for Wasabi's
# outage shapes (rarer + longer than ArchivesSpace's, so a longer base).
AIP_STORE_RETRY_BASE_BACKOFF_MS=60000
AIP_STORE_RETRY_MAX_BACKOFF_MS=1800000
AIP_STORE_MAX_ATTEMPTS=5
# Chunk size for the admin AIP-backfill action at
# /dashboard/admin/aip-backfill. Each "Start backfill" click enqueues
# up to this many synthetic Stage-6 queue rows. Operators click again
# to chew through a large catch-up. Clamped server-side to [1, 10000].
AIP_STORE_BACKFILL_CHUNK_SIZE=1000

# --- Archivematica -----------------------------------------------------------
ARCHIVEMATICA_API=https://example.invalid/api/
ARCHIVEMATICA_USERNAME=
ARCHIVEMATICA_USER_EMAIL=
ARCHIVEMATICA_USERID=
ARCHIVEMATICA_API_KEY=
ARCHIVEMATICA_TRANSFER_SOURCE=
ARCHIVEMATICA_PIPELINE=
ARCHIVEMATICA_TRANSFER_TIMEOUT=35000

# Archivematica storage service
ARCHIVEMATICA_STORAGE_API=https://example.invalid:8000/api/
ARCHIVEMATICA_STORAGE_USERNAME=
ARCHIVEMATICA_STORAGE_API_KEY=
# Storage-space UUIDs — used by the optional /health helpers that
# report DIP/AIP storage usage. Safe to leave unset; the helpers
# return null when no UUID is configured.
ARCHIVEMATICA_DIP_UUID=
ARCHIVEMATICA_AIP_UUID=

# Archivematica SFTP
SFTP_HOST=
SFTP_PORT=22
SFTP_ID=
SFTP_PWD=
SFTP_REMOTE_PATH=

# --- ArchivesSpace -----------------------------------------------------------
# Base URL of the ArchivesSpace API. The metadata-refresh worker
# appends the per-record path tail stored in tbl_objects.uri.
ARCHIVESPACE_HOST=http://localhost:8080
ARCHIVESPACE_REPOSITORY_ID=
ARCHIVESPACE_USER=
ARCHIVESPACE_PASSWORD=
# Wall-clock timeout for a single ASpace fetch (ms). ASpace can run
# slow under load — 10s is typical, 15s is the ceiling beyond which
# we'd rather time out and retry on the next poll cycle.
ARCHIVESPACE_TIMEOUT_MS=15000
# Ingest-stage ASpace fetch pacing: one record fetch per interval,
# process-wide (ASpace cannot take more than a few requests at a time;
# a burst of per-package fetches reads like an attack). 0 disables.
ASPACE_FETCH_MIN_INTERVAL_MS=10000
# Rotate the AS session token every N requests during the system-
# wide metadata refresh. Mitigates AS-side per-session cache buildup
# that's the dominant cause of "AS gets slower the longer the
# refresh runs". Set to 0 to disable (single token for the entire
# batch — pre-fix behavior). Default 500 produces a rotation roughly
# every 65 minutes at our typical 8s/request pace.
ARCHIVESPACE_TOKEN_ROTATE_AFTER_REQUESTS=500

# Metadata-refresh worker. Bounds upstream load on ArchivesSpace:
# at most CONCURRENCY parallel fetches in flight at any time, dispatched
# every UPDATE_TIMER milliseconds. Across all open batches.
METADATA_WORKER_ENABLED=1
METADATA_WORKER_CONCURRENCY=3
METADATA_UPDATE_TIMER=8000
# Per-batch cap on staff-initiated refreshes. Collection-scoped
# refresh ignores this cap (one collection = one logical action).
METADATA_MAX_BATCH_PIDS=100
# Per-row retry backoff (ms). After a row's fetch/DB write fails, the
# worker waits this long before re-claiming it; the wait doubles on
# successive failures up to METADATA_RETRY_MAX_BACKOFF_MS. Gives
# ArchivesSpace breathing room when it's already struggling, rather
# than re-hammering on the next tick. Set base to 0 to disable.
METADATA_RETRY_BASE_BACKOFF_MS=30000
METADATA_RETRY_MAX_BACKOFF_MS=300000

# --- DuraCloud --------------------------------------------------------------
# Host + path prefix WITHOUT scheme (the proxy prepends https:// itself).
# Example: digitaldu.duracloud.org/durastore/
# Leave blank to disable DuraCloud-backed thumbnails — the proxy returns
# a local placeholder SVG and the dashboard still renders cleanly.
DURACLOUD_API=
DURACLOUD_USER=
DURACLOUD_PWD=
# Wall-clock timeout for a single thumbnail fetch (ms). DC can be slow
# under load; 15s is generous but well under typical upstream-proxy idle.
DURACLOUD_TIMEOUT_MS=15000

# --- Handle server ----------------------------------------------------------
# https://handle.net/
#
# The old standalone Python handles-service (HANDLE_SERVICE / HANDLE_API_KEY)
# is retired — those two vars are no longer read.
#
# Transport is split. READS (resolution) go over the handle server's HTTP JSON
# API from Node. WRITES go through the DuHandleTool Java helper on the native
# protocol, because the handle server serves no authentication over HTTP.
#
# The helper is built on a DEV machine and its jar is committed — the repov2
# server has a JRE only (java-11-openjdk, no -devel) so it has no compiler.
# Rebuild after editing java/DuHandleTool.java:
#   HANDLE_CLIENT_LIB=/opt/library_applications/handle-client-9.3.1/lib \
#       npm run build:handle-helper
#
# Handle server HTTP interface, used for RESOLUTION. ORIGIN ONLY — no path.
# The client appends /api/handles/... itself; leaving a path here makes the
# server try to resolve "api/handles" as a handle name.
HANDLE_ADMIN_URL=http://handle.example.edu:8000
# Prefix administrator: "<index>:0.NA/<prefix>". The prefix here must match
# HANDLE_PREFIX below.
HANDLE_ADMIN_ID=300:0.NA/20.500.12345
# Handle BINARY format key (admpriv.bin) — the Java helper reads it directly,
# so no hdl-convert-key conversion is needed. Keep it outside any synced tree.
HANDLE_ADMIN_KEY_PATH=/etc/repov2/admpriv.bin
HANDLE_ADMIN_PASSPHRASE=
# Write helper. Set HANDLE_CLIENT_LIB to the handle client's lib/ directory —
# the same var java/build.sh takes. The classpath is derived from it plus the
# jar's location inside this checkout, so it follows the deploy automatically
# and there is no absolute classpath to keep in sync.
HANDLE_JAVA_BIN=java
HANDLE_CLIENT_LIB=/opt/library_applications/handle-client-9.3.1/lib
# Only set this to override the derivation above (unusual layouts):
# HANDLE_HELPER_CLASSPATH=
# Where handles RESOLVE TO. Affects future mints/updates only.
HANDLE_TARGET=https://example.edu/object/
# Hosts a HAND-MINTED handle (Admin Utils > Handles) may point at. Comma-
# separated; a target matches if its host equals an entry or is a subdomain
# of one. Left unset it falls back to the host of HANDLE_TARGET, so an
# unconfigured deployment is restricted to its own domain rather than open.
HANDLE_ALLOWED_TARGET_HOSTS=du.edu
# Batches (collection folders) whose name contains one of these tokens mint NO
# handle — stops a test ingest run against production creating a real,
# permanent identifier. Matched as whole delimiter-separated tokens, so
# "U358_LDT_TEST_Collection-resources_1204" is caught but "testament-papers"
# is not. Comma-separated, case-insensitive. NOT applied to package names:
# those become ArchivesSpace component ids during Make Digital Objects.
# Blanking this restores the default; to disable, set a token nothing matches.
HANDLE_SKIP_BATCH_TOKENS=test
# Public handle URL stored in tbl_objects.handle: server + prefix + uuid
HANDLE_PREFIX=20.500.12345
HANDLE_SERVER=https://hdl.handle.net/
HANDLE_TTL=86400
HANDLE_TIMEOUT_MS=30000

# --- Kaltura ----------------------------------------------------------------
KALTURA_PARTNER_ID=
KALTURA_USER_ID=
KALTURA_SECRET_KEY=

# --- Thumbnail / convert / transcript services ------------------------------
# TN service generates fresh thumbnails per object from source files.
# Preferred over DuraCloud where available (more consistent quality).
# v2's thumbnail proxy tries TN first, then falls back to DuraCloud
# for legacy rows. Wire pattern matches v1:
#   <TN_SERVICE>/datastream/<pid>/tn?key=<API_KEY>
TN_SERVICE=
TN_SERVICE_API_KEY=
# Per-fetch timeout in ms. The TN service can run slow on first
# generation (it's pulling the source and resizing); 30s is generous.
TN_SERVICE_TIMEOUT_MS=30000
# Disk cache for successful TN fetches. Write-once, no TTL — manual
# delete from this dir to force a re-fetch. Mirrors v1's tn_cache/
# layout (one <pid>.jpg per cached entry).
TN_CACHE_PATH=./public/tn_cache
# Legacy v1 ingest path. Not read by v2.
TN_UPLOAD_PATH=./uploads/tn

# Where the v2 dashboard's "Change thumbnail" upload modal writes JPEGs.
# Files are saved as <pid>.jpg under this directory and served at
# /repo/static/tn/<pid>.jpg. Defaults to ./public/thumbnails for dev.
THUMBNAIL_UPLOAD_PATH=./public/thumbnails
# Per-upload cap (bytes). Matches v1's 500 KB limit.
THUMBNAIL_MAX_BYTES=512000
# Externally-visible base URL used when storing the uploaded thumbnail's
# absolute URL in tbl_objects.thumbnail. Set this in production to the
# public host (e.g. https://repo.du.edu) so the stored URL survives a
# move behind a different proxy. Empty falls back to the request's
# Host header — fine for dev only.
PUBLIC_BASE_URL=

# Convert service — DU's TIFF→JPG derivative generator (libspec02). The
# convert/ subsystem submits repo objects to this API one at a time,
# paced CONVERT_SERVICE_DELAY_MS apart, because the service is fragile
# under load (the legacy post_tiff_convert.py used the same 20s pacing).
# Auth is an api_key query param. Wire pattern:
#   <CONVERT_SERVICE>?api_key=<KEY>   (POST JSON body per object)
# Leave url/key empty to keep the worker idle (the dashboard shows a
# "not configured" notice and Start won't process).
CONVERT_SERVICE=
CONVERT_SERVICE_API_KEY=
# Per-request HTTP timeout (ms).
CONVERT_SERVICE_TIMEOUT_MS=30000
# Cooldown BETWEEN requests, end-of-one to start-of-next (ms). 20s
# matches the legacy script — do not lower without confirming the
# convert server can take the load.
CONVERT_SERVICE_DELAY_MS=20000
# Poll cadence while the queue is empty (ms).
CONVERT_SERVICE_IDLE_POLL_MS=5000
# Per-row retry ceiling before a row is marked FAILED (terminal).
CONVERT_SERVICE_MAX_ATTEMPTS=3
# Max objects a single collection batch may enqueue (guard rail).
CONVERT_MAX_BATCH=5000
# Set false to stop the worker draining the queue (e.g. read-only mode).
CONVERT_WORKER_ENABLED=true

TRANSCRIPT_SERVICE=
TRANSCRIPT_SERVICE_API_KEY=

MIGRATION_SERVICE_API_KEY=

# --- Mail relay -------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- Timers / pipeline tuning -----------------------------------------------
# Transfer approval occurs N ms after transfer
TRANSFER_APPROVAL_TIMER=35000
# Transfer status checks
TRANSFER_STATUS_CHECK_INTERVAL=4000
# Ingest status checks
INGEST_STATUS_CHECK_INTERVAL=4000
# Time between each record index
INDEX_TIMER=300
# (METADATA_UPDATE_TIMER lives in the ArchivesSpace section above.)

# --- Operational flags -------------------------------------------------------
# Disable the restart-resumer (skip resuming in-progress pipelines on boot)
INGEST_DISABLE_RESUME=0
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
