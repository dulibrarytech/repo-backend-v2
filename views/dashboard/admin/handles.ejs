<%/* Admin: Handles.

     Mint a small number of handles by hand and remove ones minted by
     mistake. These are NOT necessarily attached to repository records —
     the target is operator-supplied and validated against an allowlist of
     DU hosts.

     The mint form renders a fixed five rows rather than an add-row
     control: "up to 5" is then enforced by the markup itself and needs no
     client JS beyond HTMX. Blank rows are dropped server-side.

     See repo/REPOV2_HANDLES_ADMIN_PLAN.md. */%>
<h1 class="page-title">Handles</h1>
<p class="page-subtitle">
    Mint persistent identifiers under the <code><%= handle_prefix %></code>
    prefix for pages that are not repository records &mdash; exhibits,
    finding aids, guides.
</p>

<% if (!configured) { %>
    <div class="alert alert-warning" role="alert" style="margin-bottom: 16px;">
        <strong>Handle minting is not configured.</strong>
        The <code>HANDLE_*</code> settings are incomplete, so the form below
        is inert. See <code>.env-example</code>.
    </div>
<% } %>

<div class="content-card">
    <div class="content-card-header">
        <h2 style="font-size: 18px; margin: 0;">Mint handles</h2>
    </div>

    <form hx-post="<%= dashboard_base %>/admin/handles/mint"
          hx-target="#handles-list"
          hx-swap="innerHTML"
          style="padding: 16px;">

        <p style="font-size: 13px; color: var(--text-muted, #6c757d); margin-top: 0;">
            Add up to <%= max_per_submission %> at a time. The identifier itself
            is generated automatically &mdash; supply only where it should
            point. Allowed hosts:
            <% allowed_hosts.forEach(function (h, i) { %><code><%= h %></code><%= i < allowed_hosts.length - 1 ? ', ' : '' %><% }); %>
            (and their subdomains), over https.
        </p>

        <%/* ONE row is rendered server-side; dashboard.js clones it on
             "Add another handle", up to max_per_submission.

             Progressive enhancement: the Add and Remove controls start
             `hidden` and are revealed by that script, so with JS off the
             operator gets a working single-handle form rather than buttons
             that do nothing.

             Labels, ids and the Remove control's accessible name are all
             (re)assigned by renumber() in the script, so they stay correct
             as rows are added and removed. */%>
        <table class="queue-table" style="margin-bottom: 12px;">
            <caption class="visually-hidden">Handles to mint</caption>
            <thead>
                <tr>
                    <th style="width: 55%;">Target URL</th>
                    <th>Note (optional)</th>
                    <th style="width: 1%;"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody id="handle-rows" data-max="<%= max_per_submission %>">
                <tr class="handle-row">
                    <td>
                        <label data-for="target" for="target-1" class="visually-hidden">
                            Target URL 1
                        </label>
                        <input type="url"
                               id="target-1"
                               name="target_url"
                               class="form-control form-control-sm"
                               placeholder="https://…"
                               autocomplete="off"
                               <%= configured ? '' : 'disabled' %>>
                    </td>
                    <td>
                        <label data-for="note" for="note-1" class="visually-hidden">
                            Note 1
                        </label>
                        <input type="text"
                               id="note-1"
                               name="note"
                               class="form-control form-control-sm"
                               placeholder="What is this for?"
                               maxlength="500"
                               autocomplete="off"
                               <%= configured ? '' : 'disabled' %>>
                    </td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary handle-row-remove"
                                aria-label="Remove handle 1"
                                hidden>
                            Remove
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>

        <button type="button"
                id="handle-add-row"
                class="btn btn-sm btn-outline-secondary"
                style="margin-bottom: 12px;"
                hidden
                <%= configured ? '' : 'disabled' %>>
            + Add another handle
        </button>

        <%/* Row add/remove is a visual change a screen reader would
             otherwise miss entirely — announce it, along with how many
             more are allowed. */%>
        <p id="handle-rows-status" class="visually-hidden" role="status" aria-live="polite"></p>

        <div>
            <button type="submit"
                    class="btn btn-primary btn-sm"
                    <%= configured ? '' : 'disabled' %>>
                Mint handles
            </button>
            <span class="htmx-indicator">
                <span class="spinner-border spinner-border-sm text-muted" role="status" aria-label="Minting"></span>
            </span>
        </div>
        <p style="font-size: 12px; color: var(--text-muted, #6c757d); margin: 10px 0 0;">
            Minting contacts the handle server and takes a few seconds.
        </p>
    </form>
</div>

<div class="content-card" style="margin-top: 16px;">
    <div id="handles-list"
         role="region"
         aria-live="polite"
         aria-atomic="false">
        <%- include('../partials/handles_list', {
            dashboard_base: dashboard_base,
            rows: rows,
            status_filter: status_filter,
            statuses: statuses
        }) %>
    </div>
</div>
