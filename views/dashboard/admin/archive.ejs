<%/* Admin: Batch Backups (Wasabi) browser.

     Read-only view over the Wasabi batch archive (the retired
     003-ingested folders' replacement). The page shell renders the
     title + search box + an HTMX container; the container loads the
     collections level on page load and then drives its own drill-down
     — every folder link and the Load more button re-target the same
     container via /dashboard/admin/archive/list. */%>
<h1 class="page-title">Batch Backups</h1>
<p class="page-subtitle">
    Non-preservation snapshots of ingested batches, stored in cloud
    storage (Wasabi). Preservation copies live in the AIP store (Wasabi)
    and DuraCloud. Open a collection folder to see its archival object
    folders and files.
</p>

<div class="content-card">
    <div class="content-card-header" style="display: flex; align-items: center; justify-content: flex-end; gap: 12px;">
        <label style="display: flex; align-items: center; gap: 8px; font-weight: normal;">
            <span class="text-muted small">Filter loaded names:</span>
            <input type="text" name="q" id="archive-filter"
                   class="form-control form-control-sm" style="width: 220px;"
                   placeholder="type to filter"
                   hx-get="<%= dashboard_base %>/admin/archive/list"
                   hx-target="#archive-level"
                   hx-swap="innerHTML"
                   hx-trigger="keyup changed delay:300ms"
                   hx-include="#archive-level [name=collection], #archive-level [name=package]">
        </label>
    </div>

    <div id="archive-level"
         hx-get="<%= dashboard_base %>/admin/archive/list"
         hx-trigger="load"
         hx-swap="innerHTML">
        <div class="empty-state" style="padding: 24px;">Loading backups&hellip;</div>
    </div>
</div>
