<h1 class="page-title">ArchivesSpace Links</h1>
<p class="page-subtitle">
    Adds the handle of each newly ingested object to its ArchivesSpace record.
    A record that already has a link is never changed.
</p>

<div class="content-card">
    <div class="content-card-header">
        <h2 style="font-size: 18px; margin: 0;">Status</h2>
        <div class="control-group">
            <span class="htmx-indicator">
                <span class="spinner-border spinner-border-sm text-muted" role="status" aria-label="Loading"></span>
            </span>
        </div>
    </div>

    <div id="aspace-links-status"
         hx-get="<%= dashboard_base %>/admin/aspace-links/status"
         hx-trigger="every 10s, aspace-links-status from:body"
         hx-swap="innerHTML">
        <%- include('../partials/aspace_links_status', {
            dashboard_base: dashboard_base,
            table_missing: table_missing,
            summary: summary,
            labels: labels,
            worker_enabled: worker_enabled,
            writes_enabled: writes_enabled,
            writes_requested: writes_requested
        }) %>
    </div>
    <div id="aspace-links-announce"
         class="visually-hidden"
         role="status"
         aria-live="polite"
         data-last="<%= summary.waiting_error || '' %>"></div>

    <%
        let confirm_text = 'Check every record that is not already known to have a link? Nothing will be changed. This runs in the background. The first time it reads every record, which takes about an hour.';
        if (writes_enabled) {
            confirm_text = 'Add a link to each ArchivesSpace record found without one? Records already known to have a link are skipped. This runs in the background. The first time it reads every record, which takes about an hour.';
        }
        if (!worker_enabled) {
            confirm_text = 'Queue every record that is not already known to have a link for a check? Automatic checking is off, so nothing is checked until it is turned on.';
        }
    %>
    <form hx-post="<%= dashboard_base %>/admin/aspace-links/check-all"
          hx-target="#aspace-links-status"
          hx-swap="innerHTML"
          style="margin: 0;">
        <button type="submit"
                class="btn btn-primary"
                data-confirm="<%= confirm_text %>"
                data-confirm-title="Check all records?"
                data-confirm-label="Check all">
            Check all records
        </button>
    </form>
</div>

<div class="content-card" style="margin-top: 16px;">
    <div id="aspace-links-list"
         hx-get="<%= dashboard_base %>/admin/aspace-links/list"
         hx-trigger="aspace-links-changed from:body"
         hx-include="#aspace-links-state"
         hx-swap="innerHTML"
         role="region"
         aria-label="Records"
         aria-live="polite"
         aria-atomic="false">
        <%- include('../partials/aspace_links_list', {
            dashboard_base: dashboard_base,
            rows: rows,
            total: total,
            state_filter: state_filter,
            labels: labels
        }) %>
    </div>
</div>
