<%/* Indexer status partial. Polled every 5s by the admin page; also
     returned (with HX-Trigger: toast) after a reindex action so the
     panel updates without a separate fetch.

     Three columns of state:
       - DB-side counters: dirty (is_updated=1), indexed flag set,
         eligible (published+active)
       - ES cluster: configured?, health color, doc count in the
         public index
       - Drift: eligible vs indexed in ES — should match in steady
         state; a large gap means the worker is behind or ES is down
       - Dead-letter alert: rows that exhausted the retry cap and were
         parked (index_error set). Shown only when > 0, with a "Retry
         failed" action — "no silent caps." */%>
<div class="row g-3 p-3">
    <div class="col-md-4">
        <div class="text-muted small mb-1">Dirty (awaiting indexer)</div>
        <div style="font-size: 22px; font-weight: 600;">
            <% if (counts.dirty > 0) { %>
                <span class="text-warning"><%= counts.dirty.toLocaleString() %></span>
            <% } else { %>
                <%= counts.dirty.toLocaleString() %>
            <% } %>
        </div>
        <div class="text-muted small" style="margin-top: 4px;">
            Rows with <code>is_updated=1</code>. The worker drains these.
        </div>
    </div>

    <div class="col-md-4">
        <div class="text-muted small mb-1">Eligible (published &amp; active)</div>
        <div style="font-size: 22px; font-weight: 600;">
            <%= counts.eligible.toLocaleString() %>
        </div>
        <div class="text-muted small" style="margin-top: 4px;">
            Should match the ES doc count in steady state.
        </div>
    </div>

    <div class="col-md-4">
        <div class="text-muted small mb-1">ES doc count</div>
        <div style="font-size: 22px; font-weight: 600;">
            <% if (es_configured) { %>
                <%= index_count.toLocaleString() %>
            <% } else { %>
                <span class="text-muted">—</span>
            <% } %>
        </div>
        <div class="text-muted small" style="margin-top: 4px;">
            <% if (!es_configured) { %>
                <span class="text-warning">ELASTICSEARCH_HOST not set; worker is idle.</span>
            <% } else if (health.status === 'green') { %>
                <span class="sev-badge sev-success">cluster green</span>
            <% } else if (health.status === 'yellow') { %>
                <span class="sev-badge sev-warn">cluster yellow</span>
            <% } else if (health.status === 'red') { %>
                <span class="sev-badge sev-fatal">cluster red</span>
            <% } else { %>
                <span class="sev-badge sev-fatal"><%= health.status %></span>
            <% } %>
        </div>
    </div>

    <% var dead = counts.dead_lettered || 0; %>
    <% if (dead > 0) { %>
        <div class="col-12">
            <div class="alert alert-danger small mb-0 d-flex justify-content-between align-items-center" role="alert">
                <div>
                    <strong><%= dead.toLocaleString() %></strong>
                    row<%= dead === 1 ? '' : 's' %> dead-lettered — failed to
                    index repeatedly and parked (no longer auto-retried).
                    Check the log for <code>indexer_row_dead_lettered</code>,
                    fix the underlying data or mapping, then retry.
                </div>
                <form class="d-inline ms-3"
                      hx-post="<%= dashboard_base %>/admin/indexer/reindex-failed"
                      hx-target="#indexer-status"
                      hx-swap="innerHTML">
                    <button type="submit"
                            class="btn btn-sm btn-outline-danger text-nowrap"
                            data-confirm="Re-queue all dead-lettered rows for indexing? Do this only after fixing the underlying cause — otherwise they'll just fail again."
                            data-confirm-title="Retry dead-lettered?"
                            data-confirm-label="Retry failed">
                        Retry failed
                    </button>
                </form>
            </div>
        </div>
    <% } %>

    <% if (counts.eligible !== index_count && es_configured) { %>
        <div class="col-12">
            <div class="alert alert-warning small mb-0" role="alert">
                Drift detected: <%= Math.abs(counts.eligible - index_count).toLocaleString() %>
                row<%= Math.abs(counts.eligible - index_count) === 1 ? '' : 's' %>
                difference between eligible-in-DB and indexed-in-ES.
                The worker will reconcile as it processes the dirty queue,
                or you can force a full reindex below.
            </div>
        </div>
    <% } %>
</div>
