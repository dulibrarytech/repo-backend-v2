<%/* Styled confirmation modal. dashboard.js intercepts clicks on any
     element carrying `data-confirm`, fills in these placeholders from
     the element's data-confirm-* attributes, opens the modal, and on
     OK re-fires the original click with a sentinel that bypasses
     re-interception so htmx processes it normally. */%>
<div id="confirm-modal" class="modal fade" tabindex="-1" aria-labelledby="confirm-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-left: 4px solid var(--du-crimson);">
            <div class="modal-header">
                <h5 class="modal-title" id="confirm-modal-title">Confirm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="confirm-modal-message" style="white-space: pre-wrap;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirm-modal-proceed" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>
