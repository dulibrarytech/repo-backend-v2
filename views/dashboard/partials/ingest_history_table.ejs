<%
    // Columns (2026-07-24: the old Job ID column is folded into Job Type —
    // the full UUID sits under the type as a muted second line, so it no
    // longer char-wraps in a narrow column and dictates row height):
    //   Job Type (+ Job ID) | Status | Collection Folder | Packages | Job Run By | Date
    function fmt_ts(ts) {
        if (!ts) return '';
        var d = new Date(ts);
        if (isNaN(d.getTime())) return String(ts);
        return d.toISOString();
    }
%>
<% if (!rows || rows.length === 0) { %>
    <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/>
            <polyline points="3 3 3 8 8 8"/>
            <polyline points="12 7 12 12 15 14"/>
        </svg>
        <div>No jobs match your filters.</div>
    </div>
<% } else { %>
    <table class="queue-table">
        <thead>
            <tr>
                <th>Job Type</th>
                <th>Status</th>
                <th>Collection Folder</th>
                <th>Packages</th>
                <th>Job Run By</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <% rows.forEach(function (row) {
                var status_class = row.status === 'SUCCESSFUL' ? 'sev-success' : 'sev-error';
            %>
                <tr>
                    <td>
                        <code class="font-monospace small"><%= row.job_type %></code>
                        <%/* Full UUID as real selectable text (not a hover
                             title — those are invisible to keyboard/touch).
                             The visually-hidden prefix labels the bare string
                             for screen readers now that there's no Job ID
                             column header. Search matches substrings, so any
                             fragment of this still filters. */%>
                        <div class="text-muted small font-monospace">
                            <span class="visually-hidden">Job ID: </span><%= row.job_uuid %>
                        </div>
                    </td>
                    <td>
                        <span class="sev-badge <%= status_class %>">
                            <%= row.status %>
                        </span>
                        <% if (row.error) { %>
                            <details style="margin-top: 4px;">
                                <summary class="text-muted small">error</summary>
                                <pre style="margin: 4px 0 0; font-size: 11px; max-height: 160px; overflow: auto; background: var(--bs-light, #f6f6f6); padding: 6px; border-radius: 4px; white-space: pre-wrap; word-break: break-word;"><%= row.error %></pre>
                            </details>
                        <% } %>
                    </td>
                    <td class="package-cell">
                        <div class="package-name"><%= row.collection_folder %></div>
                    </td>
                    <td>
                        <% if (!row.packages || row.packages.length === 0) { %>
                            <span class="text-muted small"><em>none</em></span>
                        <% } else { %>
                            <%
                                /*
                                 * Long package lists collapse behind a native
                                 * <details> disclosure — same pattern (and
                                 * same 8/5 thresholds) as workspace_table.ejs,
                                 * so a 95-package run doesn't stretch its
                                 * history row across screens.
                                 */
                                var pkg_collapse = row.packages.length > 8;
                                var pkg_visible = pkg_collapse ? row.packages.slice(0, 5) : row.packages;
                                var pkg_hidden = pkg_collapse ? row.packages.slice(5) : [];
                            %>
                            <ul style="margin: 0; padding-left: 18px; list-style: disc;">
                                <% pkg_visible.forEach(function (pkg) { %>
                                    <li style="font-size: 13px; padding: 1px 0;"><%= pkg %></li>
                                <% }); %>
                            </ul>
                            <% if (pkg_collapse) { %>
                                <details style="margin-top: 4px;">
                                    <summary style="cursor: pointer; font-size: 13px; color: var(--text-muted); padding: 2px 0;">
                                        Show <%= pkg_hidden.length %> more packages
                                    </summary>
                                    <ul style="margin: 0; padding-left: 18px; list-style: disc;">
                                        <% pkg_hidden.forEach(function (pkg) { %>
                                            <li style="font-size: 13px; padding: 1px 0;"><%= pkg %></li>
                                        <% }); %>
                                    </ul>
                                </details>
                            <% } %>
                        <% } %>
                    </td>
                    <td>
                        <%/* Show a person, never a du_id: the resolved name
                             when we have one, else the raw actor ONLY if it's
                             human-readable (email / "staff (ip)") — an
                             all-digit du_id renders as the unknown dash. */%>
                        <% if (row.actor_name) { %>
                            <div><%= row.actor_name %></div>
                        <% } else if (row.actor && !/^\d+$/.test(row.actor)) { %>
                            <code class="font-monospace small"><%= row.actor %></code>
                        <% } else { %>
                            <span class="text-muted small">—</span>
                        <% } %>
                    </td>
                    <td>
                        <time datetime="<%= fmt_ts(row.created) %>"
                              class="font-monospace small">
                            <%= fmt_ts(row.created) %>
                        </time>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <%
        var prev_offset = Math.max(0, offset - limit);
        var next_offset = offset + limit;
        var has_more = offset + rows.length < total;
        var qs = function (off) {
            var u = new URLSearchParams();
            u.set('limit', String(limit));
            u.set('offset', String(off));
            if (filters.q) u.set('q', filters.q);
            if (filters.job_type) u.set('job_type', filters.job_type);
            if (filters.status) u.set('status', filters.status);
            return u.toString();
        };
    %>
    <div class="app-pagination">
        <div class="results-count">
            Showing <strong><%= offset + 1 %></strong>–<strong><%= offset + rows.length %></strong>
            of <strong><%= total.toLocaleString() %></strong>
        </div>
        <nav class="page-controls" aria-label="Pagination">
            <button type="button"
                    <%= offset === 0 ? 'disabled' : '' %>
                    hx-get="<%= dashboard_base %>/ingest/history/list?<%= qs(prev_offset) %>"
                    hx-target="#history-content"
                    hx-swap="innerHTML">
                ← Previous
            </button>
            <button type="button"
                    <%= !has_more ? 'disabled' : '' %>
                    hx-get="<%= dashboard_base %>/ingest/history/list?<%= qs(next_offset) %>"
                    hx-target="#history-content"
                    hx-swap="innerHTML">
                Next →
            </button>
        </nav>
    </div>
<% } %>
