<%
    // v2-shaped queue row.
    //
    // Mirrors ingest-service's views/dashboard/partials/queue-row.ejs:
    //   Package | Status (severity badge) | Suggested action | Created | Actions
    //
    // - Status uses the shared `severity_badge` partial.
    // - Timeline opens a modal (#modal-mount) rather than a separate
    //   page. The kebab item triggers HTMX to swap the modal body and
    //   data-bs-toggle/-target open the modal.
    // - State-aware rollback/reset actions are gated by `row.actions`
    //   (resolved upstream by available_actions()).
    function fmt_ts(ts) {
        if (!ts) return '';
        var d = new Date(ts);
        if (isNaN(d.getTime())) return String(ts);
        var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
        return pad(d.getMonth() + 1) + '/' + pad(d.getDate()) + '/' + d.getFullYear() +
            ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }
    // Short byte formatter for the upload-progress readout. Inline (like
    // fmt_ts) so the partial stays self-contained and CSP-safe.
    function fmt_bytes(n) {
        var v = Number(n);
        if (!isFinite(v) || v < 0) return '—';
        if (v < 1024) return Math.round(v) + ' B';
        var units = ['KB', 'MB', 'GB', 'TB', 'PB'];
        var i = -1;
        do { v /= 1024; i += 1; } while (v >= 1024 && i < units.length - 1);
        return v.toFixed(1) + ' ' + units[i];
    }
    // Live byte-progress for the Archivematica SFTP upload (Stage 2). The
    // worker persists bytes_uploaded + total_bytes each poll; the queue
    // table's 5s refresh makes the bar climb. Only shown while UPLOADING
    // and once we have a total (else fall back to the suggested_action).
    var up_bytes = Number(row.bytes_uploaded) || 0;
    var tot_bytes = Number(row.total_bytes) || 0;
    var show_upload_progress = row.pipeline_state === 'UPLOADING' && tot_bytes > 0;
    var up_pct = show_upload_progress ? Math.min(100, Math.round((up_bytes / tot_bytes) * 100)) : 0;

    // Relative "ago" for the Archivematica/DuraCloud heartbeat (last_poll_at,
    // epoch ms). Lets staff see a slow stage is still alive vs stalled.
    function fmt_ago(ms) {
        var t = Number(ms);
        if (!isFinite(t) || t <= 0) return null;
        var s = Math.max(0, Math.round((Date.now() - t) / 1000));
        if (s < 60) return s + 's ago';
        var m = Math.round(s / 60);
        if (m < 60) return m + 'm ago';
        return Math.round(m / 60) + 'h ago';
    }
    // Step-level feedback for the long-running AM transfer/ingest + DuraCloud-
    // wait states: show the current AM microservice ("where it is") and a
    // heartbeat ("checked Ns ago"). AM exposes the current step name, not a %
    // within it — so this is the meaningful "it's alive and here" signal.
    var AM_PROGRESS_STATES = ['TRANSFER_STARTED', 'TRANSFER_IN_PROGRESS',
        'INGEST_IN_PROGRESS', 'WAITING_FOR_DURACLOUD'];
    var show_am_progress = !show_upload_progress
        && AM_PROGRESS_STATES.indexOf(row.pipeline_state) !== -1;
    var micro = (row.micro_service && row.micro_service !== 'PENDING') ? row.micro_service : null;
    var checked_ago = fmt_ago(row.last_poll_at);

    var actions = (row && Array.isArray(row.actions)) ? row.actions : [];
    var has_rollback = actions.indexOf('rollback_pre_ingest') !== -1
        || actions.indexOf('rollback_archivematica') !== -1
        || actions.indexOf('rollback_to_packaging') !== -1
        || actions.indexOf('reset') !== -1;
    var has_cancel = actions.indexOf('cancel') !== -1;
    var has_divider = has_rollback || has_cancel;
%>
<tr id="queue-row-<%= row.id %>">
    <td class="package-cell">
        <div class="package-name"><%= row.package %></div>
        <% if (row.batch && row.batch !== 'PENDING') { %>
            <div class="package-sub">Batch: <%= row.batch %></div>
        <% } %>
        <% if (row.sip_uuid && row.sip_uuid !== 'PENDING') { %>
            <div class="package-sub font-monospace" style="font-size: 11px;"
                 title="<%= row.sip_uuid %>">
                sip: <%= row.sip_uuid %>
            </div>
        <% } %>
    </td>
    <td>
        <%- include('severity_badge', {
            severity: row.severity || 'INFO',
            state: row.pipeline_state,
            label: row.pipeline_state,
            suggested_action: row.suggested_action
        }) %>
    </td>
    <td>
        <% if (show_upload_progress) { %>
            <div class="text-muted small mb-1">
                Uploading to Archivematica — <%= fmt_bytes(up_bytes) %> / <%= fmt_bytes(tot_bytes) %> (<%= up_pct %>%)
            </div>
            <div class="progress" role="progressbar"
                 aria-label="Upload progress"
                 aria-valuenow="<%= up_pct %>" aria-valuemin="0" aria-valuemax="100"
                 style="height: 6px; max-width: 280px;">
                <div class="progress-bar" style="width: <%= up_pct %>%; background-color: var(--du-crimson);"></div>
            </div>
        <% } else if (show_am_progress) { %>
            <div class="text-muted small">
                <% if (micro) { %>
                    Archivematica — <span class="fw-semibold"><%= micro %></span>
                <% } else { %>
                    <%= row.suggested_action || 'Processing…' %>
                <% } %>
                <% if (checked_ago) { %>
                    <span class="text-muted"> · checked <%= checked_ago %></span>
                <% } %>
            </div>
        <% } else { %>
            <span class="text-muted small"><%= row.suggested_action || '' %></span>
        <% } %>
    </td>
    <td class="timestamp-cell">
        <%= fmt_ts(row.created) %>
    </td>
    <td class="actions-cell">
        <div class="dropdown">
            <button type="button" class="kebab-btn"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Actions for <%= row.package %>"
                    title="Actions">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="12" cy="6" r="1.6"/>
                    <circle cx="12" cy="12" r="1.6"/>
                    <circle cx="12" cy="18" r="1.6"/>
                </svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                <%/* Timeline — always available. Opens a modal whose
                     body is swapped in via HTMX from the timeline
                     partial endpoint. */%>
                <li>
                    <a href="#"
                       class="dropdown-item"
                       hx-get="<%= dashboard_base %>/ingest/<%= row.id %>/timeline"
                       hx-target="#modal-content"
                       hx-swap="innerHTML"
                       data-bs-toggle="modal"
                       data-bs-target="#modal-mount">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.75"
                             stroke-linecap="round" stroke-linejoin="round"
                             style="vertical-align: -2px; margin-right: 6px;">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        Timeline
                    </a>
                </li>

                <% if (has_divider) { %>
                    <li><hr class="dropdown-divider"></li>
                <% } %>

                <% if (has_cancel) { %>
                    <%/* Cancel — only for in-flight rows. The dashboard
                         endpoint signals the worker's AbortController
                         AND flips the queue row to CANCELLED_BY_USER
                         in one round-trip. Rollback options appear on
                         the next render (the response includes the
                         updated row, so the kebab repopulates with
                         the right rollback target). */%>
                    <li>
                        <a href="#"
                           class="dropdown-item"
                           style="color: var(--du-crimson);"
                           hx-post="<%= dashboard_base %>/ingest/<%= row.id %>/cancel"
                           hx-target="#queue-row-<%= row.id %>"
                           hx-swap="outerHTML"
                           hx-indicator="closest tr"
                           data-confirm-title="Cancel Package"
                           data-confirm-severity="warn"
                           data-confirm-proceed="Cancel package"
                           hx-confirm="Cancel '<%= row.package %>'? The active stage will stop on its next poll. After cancel you'll see a rollback action to clean up SFTP or Archivematica (depending on how far the package got). Continue?">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 style="vertical-align: -2px; margin-right: 6px;">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                            Cancel
                        </a>
                    </li>
                <% } %>

                <% if (actions.indexOf('rollback_to_packaging') !== -1) { %>
                    <%/* Return to Packaging — post-cancel cleanup that
                         lands the folder back in the Packaging and
                         Ingesting view. State-aware on the server:
                         calls qa.move_from_ingest_to_ready only when
                         the prior state implies the folder is in
                         002-ingest; otherwise just flips the queue
                         row (folder is still in 001-ready). */%>
                    <li>
                        <a href="#"
                           class="dropdown-item"
                           hx-post="<%= dashboard_base %>/ingest/<%= row.id %>/return-to-packaging"
                           hx-target="#queue-row-<%= row.id %>"
                           hx-swap="outerHTML"
                           hx-indicator="closest tr"
                           data-confirm-title="Return to Packaging and Ingesting"
                           data-confirm-severity="info"
                           data-confirm-proceed="Return to Packaging"
                           hx-confirm="Return '<%= row.package %>' to the Packaging and Ingesting view? The folder will be moved back to 001-ready if it was uploaded to Archivematica's SFTP staging area. Once back in Packaging, staff can re-submit after addressing the original issue.">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 style="vertical-align: -2px; margin-right: 6px;">
                                <polyline points="9 14 4 9 9 4"/>
                                <path d="M20 20v-7a4 4 0 0 0-4-4H4"/>
                            </svg>
                            Return to Packaging
                        </a>
                    </li>
                <% } %>

                <% if (actions.indexOf('rollback_pre_ingest') !== -1) { %>
                    <%/* Return to Packaging — for halt-state rows
                         (INGEST_HALTED, UPLOAD_TIMEOUT, etc.). Same
                         backend endpoint as the cancel flow's
                         Return-to-Packaging hits, just labelled
                         consistently with that flow. The folder ends
                         up back in 001-ready with uri.txt intact, so
                         it reappears in the Packaging and Ingesting
                         workspace view — never in the MDO view —
                         hence the user-facing name. */%>
                    <li>
                        <a href="#"
                           class="dropdown-item"
                           hx-post="<%= dashboard_base %>/ingest/<%= row.id %>/rollback-pre"
                           hx-target="#queue-row-<%= row.id %>"
                           hx-swap="outerHTML"
                           hx-indicator="closest tr"
                           data-confirm-title="Return to Packaging and Ingesting"
                           data-confirm-severity="info"
                           data-confirm-proceed="Return to Packaging"
                           hx-confirm="Return '<%= row.package %>' to the Packaging and Ingesting view? The folder will be moved back to the workspace (SFTP staging cleaned up). No Archivematica activity has occurred for this package — safe to re-submit after addressing the original issue.">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 style="vertical-align: -2px; margin-right: 6px;">
                                <polyline points="9 14 4 9 9 4"/>
                                <path d="M20 20v-7a4 4 0 0 0-4-4H4"/>
                            </svg>
                            Return to Packaging
                        </a>
                    </li>
                <% } %>

                <% if (actions.indexOf('rollback_archivematica') !== -1) { %>
                    <li>
                        <a href="#"
                           class="dropdown-item"
                           style="color: var(--du-crimson);"
                           hx-post="<%= dashboard_base %>/ingest/<%= row.id %>/rollback-am"
                           hx-target="#queue-row-<%= row.id %>"
                           hx-swap="outerHTML"
                           hx-indicator="closest tr"
                           data-confirm-title="Submit AIP Deletion Request"
                           data-confirm-severity="danger"
                           data-confirm-proceed="Submit request"
                           hx-confirm="Submit AIP deletion request to Archivematica for '<%= row.package %>'? An Archivematica admin will need to approve the deletion in the Storage Service UI before the AIP is fully removed. Continue?">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 style="vertical-align: -2px; margin-right: 6px;">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                <path d="M10 11v6"/><path d="M14 11v6"/>
                            </svg>
                            Rollback AIP
                        </a>
                    </li>
                <% } %>

                <% if (actions.indexOf('reset') !== -1) { %>
                    <li>
                        <a href="#"
                           class="dropdown-item"
                           hx-post="<%= dashboard_base %>/ingest/<%= row.id %>/reset"
                           hx-target="#queue-row-<%= row.id %>"
                           hx-swap="outerHTML"
                           hx-indicator="closest tr"
                           data-confirm-title="Reset Queue Row"
                           data-confirm-severity="warn"
                           data-confirm-proceed="Reset"
                           hx-confirm="Reset '<%= row.package %>'? The queue row will be cleared. No folder move or Archivematica action — this package halted before any external systems were touched.">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 style="vertical-align: -2px; margin-right: 6px;">
                                <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/>
                                <polyline points="3 3 3 8 8 8"/>
                            </svg>
                            Reset
                        </a>
                    </li>
                <% } %>

            </ul>
        </div>
    </td>
</tr>
