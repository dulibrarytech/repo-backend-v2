<tr id="collection-<%= item.pid %>">
    <td class="thumb-cell">
        <% if (item.thumbnail) { %>
            <img class="thumb-img"
                 src="<%= item.thumbnail %>"
                 alt=""
                 loading="lazy">
        <% } else { %>
            <div class="thumb-placeholder" aria-label="No thumbnail" title="No thumbnail">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                </svg>
            </div>
        <% } %>
    </td>
    <td class="package-cell">
        <%/* Title links straight to the detail page — primary one-click
             affordance. The kebab still holds an "Objects" item so the
             actions cell is consistent with the objects/users rows. */%>
        <div class="package-name">
            <a href="<%= dashboard_base %>/collections/<%= item.pid %>"
               style="color: inherit;">
                <%= item.title || '(untitled)' %>
            </a>
        </div>
        <div class="package-sub" style="font-style: normal; line-height: 1.5;">
            <% if (item.handle) { %>
                <div>
                    <a href="<%= item.handle %>" target="_blank" rel="noopener"
                       class="font-monospace"
                       style="font-size: 12px; word-break: break-all;">
                        <%= item.handle.replace(/^https?:\/\//, '') %>
                    </a>
                </div>
            <% } %>
            <div class="font-monospace text-muted"
                 style="font-size: 12px;"
                 title="<%= item.pid %>">
                <%= item.pid %>
            </div>
        </div>
    </td>
    <td>
        <strong><%= (item.member_count || 0).toLocaleString() %></strong>
        <span class="text-muted small">
            (<%= (item.published_count || 0).toLocaleString() %> pub)
        </span>
    </td>
    <td>
        <% if (item.is_active !== 1) { %>
            <span class="sev-badge sev-fatal">Deleted</span>
        <% } else if (item.is_published === 1) { %>
            <span class="sev-badge sev-success">Published</span>
        <% } else { %>
            <span class="sev-badge sev-warn">Unpublished</span>
        <% } %>
    </td>
    <td class="actions-cell">
        <div class="dropdown">
            <button type="button" class="kebab-btn"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Actions for this collection"
                    title="Actions">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="12" cy="5" r="1.75"/>
                    <circle cx="12" cy="12" r="1.75"/>
                    <circle cx="12" cy="19" r="1.75"/>
                </svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       href="<%= dashboard_base %>/collections/<%= item.pid %>">
                        <%/* list icon — view the collection's objects */%>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="8" y1="6" x2="21" y2="6"/>
                            <line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/>
                            <line x1="3" y1="12" x2="3.01" y2="12"/>
                            <line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                        Objects
                    </a>
                </li>
                <%/* Refresh ONLY the collection/resource record itself,
                     not its members. The collection detail page has a
                     separate "Refresh members' metadata" button for the
                     bulk path — keeping these two affordances on
                     different surfaces means an operator can't trigger
                     a long-running collection-wide refresh from a list
                     view by mistake.

                     Gated on is_active because the model's
                     enqueue_collection_record -> fetch_target rejects
                     soft-deleted rows with a ValidationError; hiding
                     the menu item is the cleaner UX. */%>
                <% if (item.is_active === 1) { %>
                    <li>
                        <button type="button" class="dropdown-item"
                                hx-post="<%= dashboard_base %>/collections/<%= item.pid %>/metadata/refresh"
                                hx-target="#modal-content"
                                hx-swap="innerHTML"
                                data-confirm="Re-fetch ArchivesSpace metadata for <%= item.title || item.pid %>? Members will NOT be refreshed — use the collection detail page for the full expansion."
                                data-confirm-title="Refresh collection metadata?"
                                data-confirm-label="Refresh">
                            <%/* refresh icon — re-fetch metadata. Same
                                 glyph as object_row's "Refresh metadata"
                                 so the action reads the same across
                                 collection + object surfaces. */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="23 4 23 10 17 10"/>
                                <polyline points="1 20 1 14 7 14"/>
                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/>
                                <path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/>
                            </svg>
                            Refresh metadata
                        </button>
                    </li>
                <% } %>
                <li>
                    <button type="button" class="dropdown-item"
                            hx-get="<%= dashboard_base %>/objects/<%= item.pid %>/thumbnail/form"
                            hx-target="#modal-content"
                            hx-swap="innerHTML">
                        <%/* image icon — change thumbnail */%>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                        Change thumbnail
                    </button>
                </li>
                <% if (item.handle) { %>
                    <li>
                        <a class="dropdown-item"
                           href="<%= item.handle %>"
                           target="_blank" rel="noopener">
                            <%/* external-link icon — public handle */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                <polyline points="15 3 21 3 21 9"/>
                                <line x1="10" y1="14" x2="21" y2="3"/>
                            </svg>
                            View public handle
                        </a>
                    </li>
                <% } %>
                <%/* Move / re-parent — nest this collection under another, or move
                     it to the top level. Gated on edit_object; opens a modal. */%>
                <% if (typeof can === 'function' && can('edit_object')) { %>
                    <li>
                        <button type="button" class="dropdown-item"
                                hx-get="<%= dashboard_base %>/collections/<%= item.pid %>/move/form"
                                hx-target="#modal-content"
                                hx-swap="innerHTML">
                            <%/* folder-with-arrow icon — move into a collection */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 7V5a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v3"/>
                                <path d="M12 11v8"/>
                                <polyline points="9 16 12 19 15 16"/>
                            </svg>
                            Move under collection…
                        </button>
                    </li>
                <% } %>
                <%/* Delete — only offered for EMPTY sub-collections. The
                     Sub-collections section passes allow_delete=true and the
                     row carries is_empty (set by collections.sub_collections);
                     it's hidden on the main collections list (no allow_delete)
                     and on non-empty subs. Gated on delete_object. The model
                     re-checks emptiness server-side and returns 409 otherwise.
                     On success the empty response + outerHTML swap drops the
                     row. */%>
                <% if (typeof allow_delete !== 'undefined' && allow_delete && item.is_empty
                        && typeof can === 'function' && can('delete_object')) { %>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger"
                                hx-post="<%= dashboard_base %>/collections/<%= item.pid %>/delete"
                                hx-target="#collection-<%= item.pid %>"
                                hx-swap="outerHTML"
                                data-confirm="Delete the empty sub-collection &ldquo;<%= item.title || item.pid %>&rdquo;? This removes the collection record and cannot be undone from the dashboard."
                                data-confirm-title="Delete sub-collection?"
                                data-confirm-label="Delete">
                            <%/* trash icon — delete */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                <path d="M10 11v6"/>
                                <path d="M14 11v6"/>
                                <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
                            </svg>
                            Delete
                        </button>
                    </li>
                <% } %>
            </ul>
        </div>
    </td>
</tr>
