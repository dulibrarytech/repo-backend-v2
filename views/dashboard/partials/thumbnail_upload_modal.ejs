<%/* Thumbnail upload modal — body of #modal-content.

     Form posts as multipart/form-data via htmx. The response is the
     freshly-rendered row (object_row or collection_row) which htmx
     swaps into the row's outer HTML. The accompanying HX-Trigger fires
     a `modal:close` event that dashboard.js listens for to dismiss
     this modal.

     We pre-show the current thumbnail (if any) and a `<output>` slot
     that the inline JS below uses to preview the chosen file before
     upload. That's done with a tiny FileReader — no upload happens
     until the user clicks Save. */%>
<div class="modal-header">
    <div>
        <h5 class="modal-title" id="modal-content-title" style="margin: 0;">Change thumbnail</h5>
        <div class="text-muted small font-monospace" style="margin-top: 4px;">
            <%= obj.title || obj.pid %>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form id="thumbnail-upload-form"
          hx-post="<%= dashboard_base %>/objects/<%= obj.pid %>/thumbnail"
          hx-target="#<%= obj.object_type === 'collection' ? 'collection' : 'object' %>-<%= obj.pid %>"
          hx-swap="outerHTML"
          hx-encoding="multipart/form-data">
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <div class="text-muted small mb-1">Current</div>
                <% if (obj.thumbnail) { %>
                    <img src="<%= obj.thumbnail %>"
                         alt="Current thumbnail"
                         class="thumb-preview thumb-preview-current">
                <% } else { %>
                    <div class="thumb-preview thumb-preview-empty"
                         aria-label="No current thumbnail">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                    </div>
                <% } %>
            </div>
            <div class="col-auto" aria-hidden="true">
                <span class="text-muted">→</span>
            </div>
            <div class="col-auto">
                <div class="text-muted small mb-1">New</div>
                <output for="thumbnail-file" class="d-block">
                    <div id="thumbnail-preview-new"
                         class="thumb-preview thumb-preview-empty"
                         aria-label="No file selected">
                        <span class="text-muted small">No file</span>
                    </div>
                </output>
            </div>
        </div>

        <div class="mt-3">
            <label for="thumbnail-file" class="form-label">Choose a JPEG image</label>
            <input id="thumbnail-file"
                   type="file"
                   name="thumbnail"
                   accept="image/jpeg,.jpg,.jpeg"
                   class="form-control"
                   required>
            <div class="form-text">
                JPEG only, up to 500&nbsp;KB. Larger or non-JPEG files will be rejected.
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit"
            class="btn btn-primary"
            form="thumbnail-upload-form">
        Save thumbnail
    </button>
</div>

<%/* Local preview script. CSP allows inline scripts via the same
     unsafe-inline relaxation we already grant style-src? Actually no —
     script-src is `self` + jsdelivr only. So we must NOT inline JS
     here. Wire the preview from dashboard.js instead via a delegated
     event listener keyed on #thumbnail-file. */%>
