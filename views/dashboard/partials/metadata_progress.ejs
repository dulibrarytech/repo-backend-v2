<%/* Inner progress partial. Polled by #metadata-progress (in
     metadata_progress_modal.ejs) every 1s. Once `progress.status === 'done'`
     we stop polling by emitting an empty hx-trigger and surface the
     Cancel button only while work is still in flight.

     The counters give staff a quick read of the batch: total, done,
     failed, cancelled. Failed and cancelled are surfaced separately
     because they're different kinds of bad outcomes — a 401 is a
     fixable failure (rerun), a cancellation is a deliberate stop. */%>
<div<% if (progress.status === 'done') { %> hx-swap-oob="outerHTML" id="metadata-progress"<% } %>>
    <div class="progress" style="height: 18px; margin-bottom: 12px;">
        <div class="progress-bar <%= progress.failed > 0 ? 'bg-warning' : '' %>"
             role="progressbar"
             style="width: <%= progress.percent %>%;"
             aria-valuenow="<%= progress.percent %>"
             aria-valuemin="0"
             aria-valuemax="100">
            <%= progress.percent %>%
        </div>
    </div>
    <dl class="row mb-0 small">
        <dt class="col-5 text-muted">Total</dt>
        <dd class="col-7"><%= progress.total %></dd>
        <dt class="col-5 text-muted">Completed</dt>
        <dd class="col-7"><%= progress.completed %></dd>
        <% if (progress.in_progress > 0) { %>
            <dt class="col-5 text-muted">In flight</dt>
            <dd class="col-7"><%= progress.in_progress %></dd>
        <% } %>
        <% if (progress.failed > 0) { %>
            <dt class="col-5 text-muted">Failed</dt>
            <dd class="col-7 text-warning"><%= progress.failed %></dd>
        <% } %>
        <% if (progress.cancelled > 0) { %>
            <dt class="col-5 text-muted">Cancelled</dt>
            <dd class="col-7 text-muted"><%= progress.cancelled %></dd>
        <% } %>
    </dl>

    <% if (progress.status === 'in_progress') { %>
        <%/* Cancel keeps the modal open and re-renders this partial. */%>
        <div class="mt-3">
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    hx-post="<%= dashboard_base %>/jobs/<%= progress.batch_uuid %>/cancel"
                    hx-target="#metadata-progress"
                    hx-swap="innerHTML"
                    data-confirm="Stop refreshing this batch? Records already updated stay updated.">
                Cancel batch
            </button>
        </div>
    <% } else { %>
        <%/* On 'done' we replace the entire #metadata-progress
             element via OOB swap above; without hx-trigger declared
             here, polling stops. The user can close the modal at
             their leisure. */%>
        <div class="alert alert-success mt-3 mb-0" role="alert">
            <% if (progress.failed > 0 || progress.cancelled > 0) { %>
                Batch finished with <%= progress.failed + progress.cancelled %>
                exception<%= progress.failed + progress.cancelled === 1 ? '' : 's' %>.
                Check the failed records in the queue.
            <% } else { %>
                Batch complete.
            <% } %>
        </div>
    <% } %>
</div>
