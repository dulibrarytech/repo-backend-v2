<%
    // Pure presentation partial — given a severity + state, render the
    // colored pill with the right icon. Reused by:
    //   - queue_row.ejs (the ingest queue table)
    //   - qa_check_result.ejs (per-package validation card; added in step 2)
    //
    // Inputs:
    //   severity:         INFO | WARN | ERROR | FATAL | SUCCESS
    //   state:            optional state string (e.g. 'COMPLETE', 'UPLOAD_TIMEOUT')
    //   label:            optional override for the visible text (defaults to state)
    //   suggested_action: optional — surfaced as the badge's title attr
    //
    // Carries no controller logic; the caller has already resolved
    // severity from state_metadata.js.
    var sev = (locals.severity || 'INFO').toUpperCase();
    var label = locals.label || sev;
    var state = locals.state || '';
    var sev_class = ({
        INFO:    'sev-info',
        WARN:    'sev-warn',
        ERROR:   'sev-error',
        FATAL:   'sev-fatal',
        SUCCESS: 'sev-success'
    })[sev] || 'sev-info';

    // Icon choice mirrors v2's queue dashboard: cloud-check for terminal
    // success states, cloud-error for failures, triangle for warns,
    // plain cloud for INFO/in-progress.
    var icon_path;
    if (sev === 'SUCCESS' || (sev === 'INFO' && /COMPLETE|INDEXED/i.test(state))) {
        icon_path = '<polyline points="9 13 11 15 15 11"/><path d="M17 18a4 4 0 0 0 .8-7.9 6 6 0 0 0-11.4-2A5 5 0 0 0 7 18z"/>';
        sev_class = 'sev-success';
    } else if (sev === 'WARN') {
        icon_path = '<path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>';
    } else if (sev === 'ERROR' || sev === 'FATAL') {
        icon_path = '<line x1="9" y1="11" x2="15" y2="17"/><line x1="15" y1="11" x2="9" y2="17"/><path d="M17 18a4 4 0 0 0 .8-7.9 6 6 0 0 0-11.4-2A5 5 0 0 0 7 18z"/>';
    } else {
        icon_path = '<path d="M17 18a4 4 0 0 0 .8-7.9 6 6 0 0 0-11.4-2A5 5 0 0 0 7 18z"/>';
    }
%>
<span class="sev-badge <%= sev_class %>" title="<%= locals.suggested_action || '' %>">
    <svg class="sev-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <%- icon_path %>
    </svg>
    <span><%= label %></span>
</span>
