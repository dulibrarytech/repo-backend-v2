<%/* Single <tr> for an object. Used by both the flat Objects browse and
     the embedded members table on a collection detail page.

     Columns:
       1. Selection checkbox (for bulk actions)
       2. Thumbnail (60x60 leading cell — placeholder when missing)
       3. Title  (with handle, uri, and short PID on a subtitle line)
       4. Type
       5. Status
       6. Actions

     `item.title` and `item.thumbnail` are enriched into the row by
     libs/object_projection in the dashboard controller before this
     template renders. */%>
<tr id="object-<%= item.pid %>">
    <td class="select-cell">
        <%/* Soft-deleted rows can't be selected — they're already
             tombstoned and re-selecting them shouldn't be possible.
             Hidden via {visibility: hidden} so the column still
             reserves its width and the table stays aligned. */%>
        <% if (item.is_active === 1) { %>
            <input type="checkbox" class="row-select form-check-input"
                   value="<%= item.pid %>"
                   aria-label="Select <%= item.title || item.pid %>">
        <% } %>
    </td>
    <td class="thumb-cell">
        <% if (item.thumbnail) { %>
            <%/* data-media lets dashboard.js pick the matching placeholder
                 icon if this thumbnail fails to load (broken-image handler). */%>
            <img class="thumb-img"
                 src="<%= item.thumbnail %>"
                 alt=""
                 data-media="<%= item.media_category || 'file' %>"
                 loading="lazy">
        <% } else { %>
            <%/* Media-type-specific default thumbnail (audio/video/pdf are
                 distinct from images). See partials/thumb_placeholder.ejs. */%>
            <%- include('thumb_placeholder', { media: item.media_category }) %>
        <% } %>
    </td>
    <td class="package-cell">
        <div class="package-name"><%= item.title || '(untitled)' %></div>
        <div class="package-sub" style="font-style: normal; line-height: 1.5;">
            <% if (item.handle) { %>
                <div>
                    <a href="<%= item.handle %>" target="_blank" rel="noopener"
                       class="font-monospace"
                       style="font-size: 12px; word-break: break-all;">
                        <%= item.handle.replace(/^https?:\/\//, '') %>
                    </a>
                </div>
            <% } %>
            <% if (item.uri) { %>
                <div class="font-monospace text-muted"
                     style="font-size: 12px; word-break: break-all;">
                    <%= item.uri %>
                </div>
            <% } %>
            <div class="font-monospace text-muted"
                 style="font-size: 12px;"
                 title="<%= item.pid %>">
                <%= item.pid %>
            </div>
        </div>
    </td>
    <td>
        <span class="sev-badge sev-info"
              style="text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;">
            <%= item.object_type || 'object' %>
        </span>
    </td>
    <td>
        <% if (item.is_active !== 1) { %>
            <span class="sev-badge sev-fatal">Deleted</span>
        <% } else if (item.is_published === 1) { %>
            <span class="sev-badge sev-success">Published</span>
        <% } else { %>
            <span class="sev-badge sev-warn">Unpublished</span>
        <% } %>
    </td>
    <td class="actions-cell">
        <% if (item.is_active === 1) { %>
            <%/* Kebab dropdown — each item paired with a 16px icon.
                 Icons inherit color from the dropdown-item, so the red
                 destructive variant tints its icon automatically. */%>
            <div class="dropdown">
                <button type="button" class="kebab-btn"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Actions for this object"
                        title="Actions">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <circle cx="12" cy="5" r="1.75"/>
                        <circle cx="12" cy="12" r="1.75"/>
                        <circle cx="12" cy="19" r="1.75"/>
                    </svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <%/* Kebab order is intentional (objects + recent-ingests
                         rows share this partial): Metadata → Refresh metadata
                         → Publish/Suppress → Generate JPG derivative →
                         Refresh thumbnail cache → View public handle
                         (published only) → Delete (unpublished only). */%>
                    <li>
                        <button type="button" class="dropdown-item"
                                hx-get="<%= dashboard_base %>/objects/<%= item.pid %>/metadata"
                                hx-target="#modal-content"
                                hx-swap="innerHTML">
                            <%/* info icon — metadata */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                            Metadata
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item"
                                hx-post="<%= dashboard_base %>/objects/<%= item.pid %>/metadata/refresh"
                                hx-target="#modal-content"
                                hx-swap="innerHTML"
                                data-confirm="Re-fetch metadata for this object from ArchivesSpace?"
                                data-confirm-title="Refresh metadata?"
                                data-confirm-label="Refresh">
                            <%/* refresh icon — re-fetch metadata */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="23 4 23 10 17 10"/>
                                <polyline points="1 20 1 14 7 14"/>
                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/>
                                <path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/>
                            </svg>
                            Refresh metadata
                        </button>
                    </li>
                    <% if (item.is_published !== 1) { %>
                        <li>
                            <button type="button" class="dropdown-item"
                                    hx-post="<%= dashboard_base %>/objects/<%= item.pid %>/publish"
                                    hx-target="#object-<%= item.pid %>"
                                    hx-swap="outerHTML">
                                <%/* upload-cloud icon — publish */%>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17 21H7a4 4 0 0 1 0-8h.5"/>
                                    <path d="M14 8a4 4 0 1 1 4 7"/>
                                    <polyline points="12 11 12 17"/>
                                    <polyline points="9 14 12 11 15 14"/>
                                </svg>
                                Publish
                            </button>
                        </li>
                    <% } else { %>
                        <li>
                            <button type="button" class="dropdown-item"
                                    hx-post="<%= dashboard_base %>/objects/<%= item.pid %>/suppress"
                                    hx-target="#object-<%= item.pid %>"
                                    hx-swap="outerHTML">
                                <%/* eye-off icon — suppress */%>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a19.6 19.6 0 0 1 5.06-5.94"/>
                                    <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a19.6 19.6 0 0 1-3.17 4.19"/>
                                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                                Suppress
                            </button>
                        </li>
                    <% } %>
                    <%/* Generate JPG derivative — queues this object to
                         the convert service (TIFF→JPG). Fire-and-toast:
                         hx-swap="none" so the row doesn't change; the
                         convert worker processes it in the background.
                         See convert/ and the admin page at
                         /dashboard/admin/convert. */%>
                    <li>
                        <button type="button" class="dropdown-item"
                                hx-post="<%= dashboard_base %>/objects/<%= item.pid %>/convert"
                                hx-swap="none"
                                data-confirm="Generate a JPG derivative for this object? It's queued to the convert service and processed in the background."
                                data-confirm-title="Generate JPG derivative?"
                                data-confirm-label="Generate">
                            <%/* image icon — generate JPG derivative */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                <polyline points="21 15 16 10 5 21"/>
                            </svg>
                            Generate JPG derivative
                        </button>
                    </li>
                    <%/* "Change thumbnail" is deliberately NOT offered
                         on object rows. Only collection records carry
                         a custom-uploaded thumbnail at the dashboard
                         layer — for object rows, the thumbnail comes
                         from the master file's TN service derivative
                         (see ingester/stages/repository.js) and isn't
                         operator-editable. The action lives on
                         collection_row.ejs only; the underlying route
                         POST /objects/:pid/thumbnail/form still works
                         and is used there. */%>
                    <li>
                        <button type="button" class="dropdown-item"
                                hx-post="<%= dashboard_base %>/objects/<%= item.pid %>/thumbnail/invalidate"
                                hx-swap="none"
                                data-confirm="Clear this object's cached thumbnail? The next request will fetch a fresh copy from the TN service."
                                data-confirm-title="Refresh thumbnail cache?"
                                data-confirm-label="Clear cache">
                            <%/* trash-can-with-image-icon hybrid — eraser/refresh symbol */%>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="23 4 23 10 17 10"/>
                                <path d="M20.49 9A9 9 0 1 1 18 4.42L23 9"/>
                            </svg>
                            Refresh thumbnail cache
                        </button>
                    </li>
                    <%/* View public handle — only on PUBLISHED objects (an
                         unpublished record isn't publicly resolvable, so we
                         don't advertise its handle). `item.handle` guard is
                         defensive against a published row without a minted
                         handle. Opens the public record in a new tab. */%>
                    <% if (item.is_published === 1 && item.handle) { %>
                        <li>
                            <a class="dropdown-item"
                               href="<%= item.handle %>"
                               target="_blank" rel="noopener">
                                <%/* eye icon — view public handle */%>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                View public handle
                            </a>
                        </li>
                    <% } %>
                    <%/* Delete — only exposed for UNPUBLISHED rows.
                         The model also enforces this (returns 409) so
                         hiding the menu item is purely UX. Loads a
                         confirmation modal that collects the required
                         reason text and submits the actual DELETE. */%>
                    <% if (!item.is_published) { %>
                        <li>
                            <button type="button" class="dropdown-item text-danger"
                                    hx-get="<%= dashboard_base %>/objects/<%= item.pid %>/delete/confirm"
                                    hx-target="#modal-content"
                                    hx-swap="innerHTML">
                                <%/* trash icon — delete */%>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6"/>
                                    <path d="M14 11v6"/>
                                    <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
                                </svg>
                                Delete
                            </button>
                        </li>
                    <% } %>
                </ul>
            </div>
        <% } %>
    </td>
</tr>
