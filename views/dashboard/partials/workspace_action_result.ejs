<%
    // Result banner for workspace actions (MDO, QA Check, Submit,
    // Revert).
    //
    // Inputs:
    //   ok:                boolean
    //   severity:          optional explicit override —
    //                      'success' | 'info' | 'warn' | 'error' | 'fatal'.
    //                      When unset, derived from `ok` (true → success,
    //                      false → error).
    //   action:            label string, e.g. 'Make Digital Objects'
    //   folder:            collection folder name, or null
    //   message:           summary text
    //   errors[]:          optional list of error strings
    //   detail:            optional subprocess output / structured body
    //                      (rendered in a collapsible <details>)
    //   redirect_to:       optional URL to navigate to after `redirect_delay_ms`
    //   redirect_delay_ms: optional ms delay (default 2000)
    //
    // Color treatment comes from the .content-card.sev-* CSS rules
    // in public/assets/styles.css — red for errors, green for success,
    // amber for warnings, grey/blue for info.
    const ok = !!locals.ok;
    const sev = (locals.severity || (ok ? 'success' : 'error')).toLowerCase();
    const sev_class = ({
        success: 'sev-success',
        info: 'sev-info',
        warn: 'sev-warn',
        warning: 'sev-warn',
        error: 'sev-error',
        fatal: 'sev-fatal',
    })[sev] || (ok ? 'sev-success' : 'sev-error');

    // Icon picked from the severity, not from ok. Cloud-check for
    // success, triangle-bang for warnings, cloud-X for errors/fatals,
    // cloud for info. Matches the iconography used by the severity-
    // badge partial so the same outcome reads the same way wherever
    // it surfaces.
    let icon_path;
    if (sev_class === 'sev-success') {
        icon_path =
            '<polyline points="9 13 11 15 15 11"/>' +
            '<path d="M17 18a4 4 0 0 0 .8-7.9 6 6 0 0 0-11.4-2A5 5 0 0 0 7 18z"/>';
    } else if (sev_class === 'sev-warn') {
        icon_path =
            '<path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>' +
            '<line x1="12" y1="9" x2="12" y2="13"/>' +
            '<line x1="12" y1="17" x2="12.01" y2="17"/>';
    } else if (sev_class === 'sev-error' || sev_class === 'sev-fatal') {
        icon_path =
            '<line x1="9" y1="11" x2="15" y2="17"/>' +
            '<line x1="15" y1="11" x2="9" y2="17"/>' +
            '<path d="M17 18a4 4 0 0 0 .8-7.9 6 6 0 0 0-11.4-2A5 5 0 0 0 7 18z"/>';
    } else {
        // sev-info — info circle
        icon_path =
            '<circle cx="12" cy="12" r="10"/>' +
            '<line x1="12" y1="16" x2="12" y2="12"/>' +
            '<line x1="12" y1="8" x2="12.01" y2="8"/>';
    }

    // Only auto-dismiss the SUCCESS variant; staff want to read errors
    // and warnings at their own pace.
    const auto_dismiss = (sev_class === 'sev-success');

    let detail_text = '';
    if (locals.detail !== undefined && locals.detail !== null) {
        try {
            detail_text = JSON.stringify(locals.detail, null, 2);
        } catch (e) {
            detail_text = String(locals.detail);
        }
    }
%>
<div class="content-card <%= sev_class %>"
     style="margin-bottom: 16px; padding: 12px 16px;"
     <% if (auto_dismiss) { %>data-auto-dismiss="4000"<% } %>>
    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
             style="flex-shrink: 0; margin-top: 2px;">
            <%- icon_path %>
        </svg>
        <div class="text-body" style="flex: 1; min-width: 0;">
            <div style="font-weight: 600; color: currentColor;">
                <%= locals.action || '' %>
                <% if (locals.folder) { %>
                    &mdash; <%= folder %>
                <% } %>
            </div>
            <% if (locals.message) { %>
                <div style="margin-top: 4px;"><%= message %></div>
            <% } %>
            <% if (Array.isArray(locals.errors) && locals.errors.length > 0) { %>
                <ul style="margin: 8px 0 0; padding-left: 20px;">
                    <% locals.errors.forEach(function (e) { %>
                        <li><%= e %></li>
                    <% }); %>
                </ul>
            <% } %>
            <% if (detail_text) { %>
                <details style="margin-top: 8px;">
                    <summary class="text-muted small">Show output / log</summary>
                    <pre style="margin-top: 8px; font-size: 12px; max-height: 240px; overflow: auto; background: var(--bs-light, #f6f6f6); padding: 8px; border-radius: 4px;"><%= detail_text %></pre>
                </details>
            <% } %>
        </div>
    </div>
</div>

<% if (ok && locals.redirect_to) { %>
    <%/* CSP-safe deferred redirect. We can't ship an inline
         <script> here — the page's script-src directive forbids
         inline-script-elem (no 'unsafe-inline', no nonce). Instead
         we stamp the target + delay onto data-* attributes of a
         sentinel <div>; dashboard.js section 10 picks the sentinel
         up on htmx:afterSwap and schedules the redirect from its
         (self-hosted) static bundle. Same UX, zero inline JS. */%>
    <div class="workspace-deferred-redirect"
         data-redirect-target="<%= locals.redirect_to %>"
         data-redirect-delay="<%= locals.redirect_delay_ms || 2000 %>"
         hidden></div>
<% } %>
