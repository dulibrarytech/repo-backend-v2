<% if (!items || items.length === 0) { %>
    <div class="text-muted small">No recent ingests.</div>
<% } else { %>
    <ul class="list-unstyled m-0">
        <% items.forEach(function(item) { %>
            <%/* Title-only display: each row shows the object's title and,
                 on the right, its DRAFT/PUB status + ingest date. No subtitle
                 line — the previous call-number/file-path subtitle surfaced raw
                 Archivematica paths for records without a local identifier, so
                 it was dropped. A title-less record falls back to a shortened
                 pid (never the file path) so the row isn't blank. */%>
            <% var primary = item.title || (item.pid.slice(0, 8) + '…'); %>
            <li class="py-1 small d-flex justify-content-between align-items-baseline">
                <a href="<%= dashboard_base %>/objects?q=<%= encodeURIComponent(item.pid) %>"
                   class="text-truncate"
                   style="max-width: 65%;"
                   title="<%= item.title || item.pid %>">
                    <span class="<%= item.title ? '' : 'font-monospace' %>">
                        <%= primary %>
                    </span>
                </a>
                <span class="text-muted">
                    <% if (item.is_published === 1) { %>
                        <span class="sev-badge sev-success" style="font-size: 11px; padding: 2px 8px;">PUB</span>
                    <% } else { %>
                        <span class="sev-badge sev-warn" style="font-size: 11px; padding: 2px 8px;">DRAFT</span>
                    <% } %>
                    <%= new Date(item.created).toISOString().slice(0, 10) %>
                </span>
            </li>
        <% }); %>
    </ul>
<% } %>
