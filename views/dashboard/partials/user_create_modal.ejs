<%/* Add user modal — body of #modal-content.

     Posts to /dashboard/users. On success the controller returns an
     empty body + HX-Trigger { modal:close, toast, users:created }
     so the modal dismisses, the toast pops, and the table refreshes
     itself. On validation/conflict error the response re-renders
     THIS partial with the error alert + retained field values
     (htmx-target points at #modal-content so the swap stays
     inside the modal frame). */%>
<div class="modal-header">
    <div>
        <h5 class="modal-title" id="modal-content-title" style="margin: 0;">Add user</h5>
        <div class="text-muted small" style="margin-top: 4px;">
            Grant access to a new repository staff member.
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form id="user-create-form"
          hx-post="<%= dashboard_base %>/users"
          hx-target="#modal-content"
          hx-swap="innerHTML">
        <% if (typeof error !== 'undefined' && error) { %>
            <%/* role="alert" announces the message immediately when
                 the partial re-renders after a failed POST — staff
                 with screen readers learn about the validation failure
                 without having to navigate back through the form to
                 discover it. */%>
            <div id="user-form-error" class="alert alert-danger py-2 small mb-2" role="alert">
                <%= error %>
                <% if (Array.isArray(details) && details.length > 0) { %>
                    <ul class="mb-0 mt-1">
                        <% details.forEach(function(d) { %>
                            <li><%= typeof d === 'string' ? d : JSON.stringify(d) %></li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        <% } %>
        <%/* Every field on the create form is required. The
             inline .required-badge marks them visually for staff
             (matches the edit modal). The HTML `required` attr
             stays on each input so browsers still block submission
             without it. */%>
        <div class="mb-2">
            <label class="form-label small mb-1" for="new-du-id">
                DU ID <span class="required-badge">required</span>
            </label>
            <input id="new-du-id" name="du_id"
                   class="form-control form-control-sm font-monospace"
                   required
                   autocomplete="off"
                   value="<%= (form && form.du_id) || '' %>">
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1" for="new-email">
                Email <span class="required-badge">required</span>
            </label>
            <input id="new-email" name="email" type="email"
                   class="form-control form-control-sm"
                   required
                   value="<%= (form && form.email) || '' %>">
        </div>
        <div class="row g-2">
            <div class="col">
                <label class="form-label small mb-1" for="new-first">
                    First name <span class="required-badge">required</span>
                </label>
                <input id="new-first" name="first_name"
                       class="form-control form-control-sm"
                       required
                       value="<%= (form && form.first_name) || '' %>">
            </div>
            <div class="col">
                <label class="form-label small mb-1" for="new-last">
                    Last name <span class="required-badge">required</span>
                </label>
                <input id="new-last" name="last_name"
                       class="form-control form-control-sm"
                       required
                       value="<%= (form && form.last_name) || '' %>">
            </div>
        </div>
        <%/* RBAC role. Server validates against the known roles
             (auth/rbac.js); the model defaults to 'staff' if omitted. */%>
        <div class="mt-2">
            <label class="form-label small mb-1" for="new-role">
                Role <span class="required-badge">required</span>
            </label>
            <% var sel = (form && form.role) || 'staff'; %>
            <select id="new-role" name="role" class="form-select form-select-sm" required>
                <option value="viewer"<%= sel === 'viewer' ? ' selected' : '' %>>viewer — read-only</option>
                <option value="staff"<%= sel === 'staff' ? ' selected' : '' %>>staff — curate &amp; ingest</option>
                <option value="admin"<%= sel === 'admin' ? ' selected' : '' %>>admin — full access</option>
            </select>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit"
            class="btn btn-primary"
            form="user-create-form">
        <span class="htmx-indicator spinner-border spinner-border-sm me-1"
              role="status" aria-hidden="true"></span>
        Add user
    </button>
</div>
