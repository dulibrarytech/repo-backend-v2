<div class="d-flex justify-content-between align-items-start" style="gap: 12px;">
    <div>
        <h1 class="page-title">Manage Collections</h1>
        <p class="page-subtitle">Browse repository collections. Click a title — or use the actions menu (<strong>⋮</strong>) — to drill into a collection's objects.</p>
    </div>
    <%/* Create a top-level collection bound to an ASpace resource. Gated on
         edit_object (staff + admin); `can` comes from require_dashboard_auth.
         TEMPORARY (2026-07-27): button hidden by request — flip
         show_new_collection to true to restore. The /collections/new
         route stays live for direct URLs. */%>
    <% var show_new_collection = false; %>
    <% if (show_new_collection && typeof can === 'function' && can('edit_object')) { %>
        <a href="<%= dashboard_base %>/collections/new" class="btn btn-sm btn-outline-primary text-nowrap">
            + New collection
        </a>
    <% } %>
</div>

<div class="content-card">
    <div class="content-card-header">
        <div class="control-group" style="flex: 1;">
            <input type="search" name="q" class="form-control"
                   aria-label="Search collections"
                   placeholder="Search collection titles…"
                   value="<%= filters.q || '' %>"
                   autocomplete="off"
                   style="max-width: 360px;"
                   hx-get="<%= dashboard_base %>/collections/list"
                   hx-target="#collections-table"
                   hx-trigger="keyup changed delay:300ms, search"
                   hx-include="[name=sort]">
        </div>
        <div class="control-group">
            <label for="sort" class="text-muted">Sort by</label>
            <select id="sort" name="sort" class="form-select"
                    hx-get="<%= dashboard_base %>/collections/list"
                    hx-target="#collections-table"
                    hx-trigger="change"
                    hx-include="[name=q]">
                <option value="count" <%= filters.sort === 'count' ? 'selected' : '' %>>Object count</option>
                <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title (A–Z)</option>
                <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Most recent</option>
            </select>
            <span class="htmx-indicator">
                <span class="spinner-border spinner-border-sm text-muted" role="status" aria-label="Loading"></span>
            </span>
        </div>
    </div>

    <div id="collections-table"
         hx-get="<%= dashboard_base %>/collections/list"
         hx-trigger="load, collections:refresh from:body"
         hx-swap="innerHTML">
        <div class="empty-state">
            <span class="spinner-border spinner-border-sm text-muted me-2"></span>
            Loading…
        </div>
    </div>
</div>
