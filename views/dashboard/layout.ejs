<!DOCTYPE html>
<%/* repo-backend-v2 dashboard layout shell.
     Loaded by every dashboard page; the page body is passed in as
     `body` (rendered HTML) plus locals: title, page, active. */%>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <%/* user-scalable=yes is the default but stated explicitly so it
         survives any future change to the meta tag — and so a
         linter / a11y scanner that flags missing-user-scalable on
         every dashboard page reads clean. */%>
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
    <title><%= title || 'Digital Archives @ DU' %></title>
    <link rel="icon" type="image/svg+xml" href="<%= static_base %>/images/du-main-tab-logo.svg">
    <%/* Bootstrap + HTMX are self-hosted under /static/assets/vendor (was
         cdn.jsdelivr.net). The login page used to block on this render-
         blocking CDN stylesheet when the network to DU services was down;
         same-origin assets remove that dependency. Re-vendor to upgrade. */%>
    <link rel="stylesheet" href="<%= static_base %>/assets/vendor/bootstrap.min.css?v=<%= asset_v %>">
    <%/* asset_v is a server-startup timestamp from config/app.js. Bumps
         on every restart so browsers pick up fresh CSS/JS without a
         manual hard-reload — essential when iterating on dashboard.js
         which the browser otherwise pins for hours. */%>
    <link rel="stylesheet" href="<%= static_base %>/assets/styles.css?v=<%= asset_v %>">
    <script src="<%= static_base %>/assets/vendor/htmx.min.js?v=<%= asset_v %>" defer></script>
    <script src="<%= static_base %>/assets/vendor/bootstrap.bundle.min.js?v=<%= asset_v %>" defer></script>
    <script src="<%= static_base %>/assets/dashboard.js?v=<%= asset_v %>" defer></script>
</head>
<%/* dashboard_base is exposed via data-attribute (CSP-friendly — no
     inline <script> needed). dashboard.js reads it from document.body. */%>
<body data-page="<%= page %>" data-dashboard-base="<%= dashboard_base %>">
<%/* Skip link — first focusable element on every page. Visually hidden
     until it receives keyboard focus, at which point it slides into
     view (top-left). Lets keyboard / screen-reader users bypass the
     header + sidebar and land on the page's primary content. Target is
     the <main> below; tabindex="-1" on <main> lets us move focus there
     programmatically without altering its tab order. */%>
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="app-shell">
    <%- include('partials/header', {
        user: user,
        dashboard_base: dashboard_base,
        static_base: static_base
    }) %>
    <%- include('partials/sidebar', {
        active: active,
        dashboard_base: dashboard_base
    }) %>
    <main id="main-content" class="app-main" tabindex="-1">
        <%- body %>
    </main>
    <%- include('partials/footer', {
        dashboard_base: dashboard_base,
        app_version: app_version
    }) %>
</div>

<%- include('partials/confirm_modal') %>
<%- include('partials/modal_mount') %>

<div id="toast-stack" class="toast-stack" aria-live="polite" aria-atomic="true"></div>
</body>
</html>
