<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="<%= static_base %>/images/du-main-tab-logo.svg">
    <%/* Self-hosted (was cdn.jsdelivr.net). The sign-in page must render with
         ZERO third-party network dependencies — a render-blocking CDN
         stylesheet here is exactly what stalled the page when the network to
         DU services was impaired. See layout.ejs for the asset_v rationale. */%>
    <link rel="stylesheet" href="<%= static_base %>/assets/vendor/bootstrap.min.css?v=<%= asset_v %>">
    <link rel="stylesheet" href="<%= static_base %>/assets/styles.css?v=<%= asset_v %>">
    <script src="<%= static_base %>/assets/vendor/htmx.min.js?v=<%= asset_v %>" defer></script>
    <script src="<%= static_base %>/assets/vendor/bootstrap.bundle.min.js?v=<%= asset_v %>" defer></script>
    <script src="<%= static_base %>/assets/dashboard.js?v=<%= asset_v %>" defer></script>
</head>
<body data-page="login" data-dashboard-base="<%= dashboard_base %>">
<div class="login-shell">
    <div class="login-card">
        <div class="brand-block">
            <img class="du-logo"
                 src="<%= static_base %>/images/du-logo.png"
                 alt="University Libraries — University of Denver">
            <div class="app-title">Digital Archives Manager <span class="accent">@ DU</span></div>
        </div>
        <h1>Sign in</h1>
        <div class="subtitle">Use your DU credentials to continue.</div>
        <%- include('partials/login_form', {
            app_path: app_path,
            dashboard_base: dashboard_base,
            next: next,
            error: error,
            sso_enabled: typeof sso_enabled !== 'undefined' && sso_enabled
        }) %>
    </div>
</div>
</body>
</html>
